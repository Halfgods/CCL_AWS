# CampusCare / CollegeComplaint - configuration template
# Copy this file to .env and fill in the values for your own AWS account.
# .env is git-ignored; this template is safe to commit.

# --- AWS / application configuration --------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=your-evidence-bucket
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:YourNotificationTopic
DYNAMODB_TABLE=CollegeComplaints

# --- Amazon Cognito -------------------------------------------------------
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id

# --- Frontend (Vite exposes only VITE_* variables to the browser) ---------
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your-app-client-id
VITE_API_TARGET=http://127.0.0.1:5000

# --- Optional: local development credentials ------------------------------
# On EC2, boto3 obtains short-lived credentials from the instance role, so
# these are NOT needed in production. Never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Optional: backend log directory --------------------------------------
# Defaults to <repository>/logs when unset.
# LOG_DIR=/home/ubuntu/college-complaint/logs
